---
import "../styles/global.css";
import Logo from "@/assets/images/wasel-logo.png";
import loginImg from "@/assets/images/login.jpg";
import { Image } from "astro:assets";
import { LoginForm } from "@/components/Form";
---

<section class="min-h-screen flex bg-background">
    <div class="w-full lg:w-5/12 flex justify-center items-center p-6 sm:p-12">
        {/* max-w-md prevents the form from getting too wide on tablets */}
        <div class="w-full max-w-md">
            {/* Optional: You can put your Logo here so mobile users see it! */}
            <div class="mb-8 lg:hidden flex justify-center">
                <Image src={Logo} alt="Wasel Logo" class="h-12 w-auto" />
            </div>

            <LoginForm client:load />
        </div>
    </div>

    <div class="hidden lg:block relative lg:w-7/12 h-screen">
        <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"
        >
        </div>

        <div class="absolute z-20 bottom-0 left-0 p-16">
            <h1 class="text-4xl font-bold text-white mb-4">Welcome to Wasel</h1>
            <p
                class="text-xl font-light text-gray-200 max-w-lg leading-relaxed"
            >
                Streamline your e-commerce logistics with Wasel, your all-in-one
                platform for shipping, tracking, and managing orders in Morocco.
            </p>
        </div>

        <Image
            src={loginImg}
            alt="town image"
            class="absolute inset-0 w-full h-full object-cover z-0"
        />
    </div>
</section>
