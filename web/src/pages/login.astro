---
import "../styles/global.css";
import Logo from "@/assets/images/wasel-logo.png";
import loginImg from "@/assets/images/login.jpg";
import { Image } from "astro:assets";
import { LoginForm } from "@/components/Form";
---

<section>
    <div class="flex gap-4 items-center justify-between">
        <!-- login form -->
        <div class="w-full lg:w-4/12 flex justify-center items-center">
            <div class="w-full p-4">
                <LoginForm client:visible />
            </div>
        </div>
        <!-- image -->
        <div class="relative w-full h-screen lg:w-8/12">
            <!-- text to image -->
            <div
                class="absolute w-full h-full bg-linear-to-t from-black to-transparent"
            >
                <div class="absolute z-50 bottom-0 left-0 p-12">
                    <h1 class="text-2xl font-bold text-popover">
                        Welcome to wasel
                    </h1>
                    <p class="text-xl font-light text-popover">
                        Streamline your e-commerce logistics with Wasel, your
                        all-in-one platform for shipping, tracking, and managing
                        orders in Morocco.
                    </p>
                </div>
            </div>
            <Image
                src={loginImg}
                alt="town image"
                class="w-full h-full object-cover"
            />
        </div>
    </div>
</section>
