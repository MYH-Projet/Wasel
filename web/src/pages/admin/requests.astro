---
import AdminLayout from "@/layouts/AdminLayout.astro";
import MetricsOverview from "@/components/sections/admin/requests/MetricsOverview.astro";
import { PendingDriversTable } from "@/components/sections/admin/requests/PendingDriversTable";

const INTERNAL_API_URL = import.meta.env.INTERNAL_API_URL;
let driversRequestsData: any[] = [];
try {
    const user = Astro.locals.user;
    const DriversRequests = await fetch(
        `${INTERNAL_API_URL}/api/admin/drivers/requests`,
        {
            method: "GET",
            headers: {
                Authorization: `Bearer ${user?.token}`,
            },
        },
    );
    driversRequestsData = await DriversRequests.json();
    console.log(driversRequestsData);
} catch (error) {
    console.log(error);
}
---

<AdminLayout>
    <div class="p-6 md:p-10 max-w-7xl mx-auto space-y-10">
        <header class="space-y-2">
            <h1
                class="text-4xl font-black tracking-tight text-slate-900 sm:text-5xl uppercase"
            >
                Driver Approval <span class="text-primary">Requests</span>
            </h1>
            <p class="text-lg text-slate-500 font-medium max-w-2xl">
                Manage and review incoming fleet applications with real-time
                metrics and detailed insights.
            </p>
        </header>

        <section>
            <!-- <MetricsOverview /> -->
            <PendingDriversTable
                data={driversRequestsData}
                client:only="react"
            />
        </section>
    </div>
</AdminLayout>
