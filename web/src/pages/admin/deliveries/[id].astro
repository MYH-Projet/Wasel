---
import AdminLayout from "@/layouts/AdminLayout.astro";
import DeliveryDetailsWrapper from "@/components/sections/admin/deliveries/DeliveryDetailsWrapper.astro";
import { DeliveryActionButtons } from "@/components/sections/admin/deliveries/DeliveryActionButtons";

const { id } = Astro.params;
---

<AdminLayout title={`Delivery Details - ${id}`}>
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Delivery Details</h1>
        </div>
        <DeliveryActionButtons client:load deliveryId={id!} />
    </div>

    <DeliveryDetailsWrapper server:defer deliveryId={id!}>
        <div slot="fallback" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-card rounded-xl shadow-sm overflow-hidden h-[400px] border border-border flex flex-col relative">
                    <div class="p-4 border-b border-border flex justify-between">
                        <div class="h-6 w-48 bg-muted rounded animate-pulse"></div>
                        <div class="h-4 w-24 bg-muted rounded animate-pulse"></div>
                    </div>
                    <div class="flex-grow bg-muted/30 animate-pulse"></div>
                    <div class="absolute bottom-6 left-6 w-64 h-24 bg-card rounded-lg shadow-md border border-border animate-pulse"></div>
                </div>

                <div class="bg-card rounded-xl shadow-sm p-6 border border-border">
                    <div class="h-6 w-48 bg-muted rounded animate-pulse mb-8"></div>
                    <div class="space-y-8 pl-4 border-l-2 border-border ml-2">
                        {
                            [1, 2, 3].map(() => (
                                <div class="relative pl-6">
                                    <div class="absolute -left-[33px] top-0 w-6 h-6 rounded-full bg-muted animate-pulse border-4 border-card" />
                                    <div class="h-4 w-40 bg-muted rounded animate-pulse mb-2" />
                                    <div class="h-3 w-3/4 bg-muted/50 rounded animate-pulse" />
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class="bg-card rounded-xl shadow-sm p-6 border border-border">
                    <div class="h-4 w-40 bg-muted rounded animate-pulse mb-6"></div>
                    <div class="p-4 bg-muted/20 rounded-xl mb-4 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-muted animate-pulse"></div>
                        <div class="space-y-2 flex-1">
                            <div class="h-3 w-16 bg-muted rounded animate-pulse"></div>
                            <div class="h-4 w-32 bg-muted/80 rounded animate-pulse"></div>
                        </div>
                    </div>
                    <div class="p-4 bg-muted/20 rounded-xl flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-muted animate-pulse"></div>
                        <div class="space-y-2 flex-1">
                            <div class="h-3 w-16 bg-muted rounded animate-pulse"></div>
                            <div class="h-4 w-32 bg-muted/80 rounded animate-pulse"></div>
                        </div>
                    </div>
                </div>

                <div class="bg-card rounded-xl shadow-sm p-6 border border-border">
                    <div class="h-4 w-32 bg-muted rounded animate-pulse mb-6"></div>
                    <div class="flex gap-4 mb-4">
                        <div class="w-10 h-10 rounded-lg bg-muted animate-pulse"></div>
                        <div class="space-y-2 flex-1">
                            <div class="h-4 w-48 bg-muted rounded animate-pulse"></div>
                            <div class="h-3 w-24 bg-muted/80 rounded animate-pulse"></div>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-1 h-16 bg-muted/40 rounded-lg animate-pulse"></div>
                        <div class="flex-1 h-16 bg-muted/40 rounded-lg animate-pulse"></div>
                    </div>
                </div>

                <div class="bg-card rounded-xl shadow-sm p-6 border border-border">
                    <div class="h-4 w-32 bg-muted rounded animate-pulse mb-6"></div>
                    <div class="flex justify-between mb-4 pb-4 border-b border-border">
                        <div class="h-4 w-16 bg-muted rounded animate-pulse"></div>
                        <div class="h-4 w-24 bg-muted rounded animate-pulse"></div>
                    </div>
                    <div class="flex justify-between items-end mt-6">
                        <div class="h-4 w-24 bg-muted rounded animate-pulse"></div>
                        <div class="h-8 w-32 bg-muted rounded animate-pulse"></div>
                    </div>
                </div>

                <div class="bg-card rounded-xl shadow-sm p-6 border border-border">
                    <div class="h-4 w-40 bg-muted rounded animate-pulse mb-6"></div>
                    <div class="space-y-6 pl-2 border-l-2 border-dashed border-border ml-2">
                        <div class="relative pl-6">
                            <div class="absolute -left-[21px] top-1 w-3 h-3 rounded-full bg-muted animate-pulse border-2 border-card"></div>
                            <div class="h-3 w-16 bg-muted rounded animate-pulse mb-2"></div>
                            <div class="h-4 w-32 bg-muted/80 rounded animate-pulse mb-1"></div>
                            <div class="h-3 w-48 bg-muted/50 rounded animate-pulse"></div>
                        </div>
                        <div class="relative pl-6">
                            <div class="absolute -left-[21px] top-1 w-3 h-3 rounded-full bg-muted animate-pulse border-2 border-card"></div>
                            <div class="h-3 w-16 bg-muted rounded animate-pulse mb-2"></div>
                            <div class="h-4 w-32 bg-muted/80 rounded animate-pulse mb-1"></div>
                            <div class="h-3 w-48 bg-muted/50 rounded animate-pulse"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </DeliveryDetailsWrapper>
</AdminLayout>
