---
import { Mail, Ban } from "lucide-react";
import { DriverHeaderActions } from "./DriverHeaderActions";
import type { DriverDetails } from "@/types/driver";

interface Props {
    driverData: DriverDetails;
}

const { driverData } = Astro.props;
const fullName = `${driverData.firstName} ${driverData.lastName}`;

const statusColors: Record<string, string> = {
    Approved: "bg-green-100 text-green-700",
    PendingVerification: "bg-yellow-100 text-yellow-700",
    Suspended: "bg-red-100 text-red-700",
    Rejected: "bg-red-100 text-red-700",
};
const statusClass =
    statusColors[driverData.driverStatus] || "bg-muted text-muted-foreground";
---

<div
    class="bg-card rounded-xl shadow-sm p-6 flex flex-col md:flex-row items-center justify-between gap-4"
>
    <div class="flex items-center gap-6">
        <div class="relative">
            <img
                src={`https://ui-avatars.com/api/?name=${encodeURIComponent(fullName)}&background=random&size=150`}
                alt="Profile"
                class="w-24 h-24 rounded-lg object-cover"
            />
            {
                driverData.driverStatus === "Approved" && (
                    <span class="absolute -bottom-2 -right-2 bg-yellow-500 text-secondary-foreground p-1 rounded-full border-2 border-white">
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                        </svg>
                    </span>
                )
            }
        </div>
        <div>
            <h1 class="text-3xl font-bold text-foreground">{fullName}</h1>
            <div class="flex items-center gap-3 mt-2">
                <span
                    class={`px-3 py-1 text-xs font-bold rounded-full uppercase tracking-wider ${statusClass}`}
                >
                    {driverData.driverStatus}
                </span>
            </div>
        </div>
    </div>

    <DriverHeaderActions
        client:only="react"
        driverId={driverData.driverId}
        driverName={fullName}
    />
</div>
