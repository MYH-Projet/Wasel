---
import { FileText } from "lucide-react";
import { DocumentViewerModal } from "./DocumentViewerModal";
import type { DriverDetails } from "@/types/driver";

interface Props {
    driverData: DriverDetails;
}

const { driverData } = Astro.props;
const docs = driverData.documents || [];
---

<div class="bg-card rounded-xl shadow-sm p-6 h-full">
    <h2 class="text-lg font-bold text-foreground flex items-center gap-2 mb-6">
        <span class="p-2 bg-teal-100 text-teal-700 rounded-lg">
            <FileText className="w-5 h-5" />
        </span>
        Compliance Documents
    </h2>

    {
        docs.length === 0 ? (
            <p class="text-muted-foreground text-sm italic">
                No documents uploaded yet.
            </p>
        ) : (
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs font-bold text-muted-foreground uppercase border-b">
                        <tr>
                            <th class="pb-3">Document Name</th>
                            <th class="pb-3">Status</th>
                            <th class="pb-3">Uploaded</th>
                            <th class="pb-3 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        {docs.map((doc) => (
                            <tr>
                                <td class="py-4 font-medium text-foreground flex items-center gap-2">
                                    <FileText className="w-4 h-4 text-muted-foreground" />{" "}
                                    {doc.documentType}
                                </td>
                                <td class="py-4">
                                    <span
                                        class={`px-2 py-1 text-xs font-bold rounded-md ${
                                            doc.status === "Verified"
                                                ? "bg-green-100 text-green-700"
                                                : doc.status === "Rejected"
                                                  ? "bg-red-100 text-red-700"
                                                  : "bg-yellow-100 text-yellow-700"
                                        }`}
                                    >
                                        {doc.status}
                                    </span>
                                </td>
                                <td class="py-4 text-muted-foreground">
                                    {new Date(
                                        doc.uploadedAt,
                                    ).toLocaleDateString()}
                                </td>
                                <td class="py-4 text-right">
                                    <DocumentViewerModal
                                        client:load
                                        docUrl={`https://placehold.co/600x400/e2e8f0/475569?text=${encodeURIComponent(doc.documentType)}`}
                                        documentType={doc.documentType}
                                    />
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        )
    }
</div>
