---
import { User } from "lucide-react";
import type { DriverDetails } from "@/types/driver";

interface Props {
    driverData: DriverDetails;
}

const { driverData } = Astro.props;
const fullName = `${driverData.firstName} ${driverData.lastName}`;
---

<div class="bg-card rounded-xl shadow-sm p-6 h-full">
    <h2 class="text-lg font-bold text-foreground flex items-center gap-3 mb-8">
        <span class="p-2 bg-muted text-foreground rounded-lg">
            <User className="w-5 h-5" />
        </span>
        Personal Info
    </h2>

    <div class="space-y-6">
        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Full Name
            </p>
            <p class="text-foreground font-medium">{fullName}</p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Email Address
            </p>
            <p class="text-foreground font-medium">{driverData.email}</p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Phone Number
            </p>
            <p class="text-foreground font-medium">{driverData.phone}</p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                CIN
            </p>
            <p class="text-foreground font-medium">
                {driverData.cin || "N/A"}
            </p>
        </div>
    </div>
</div>
