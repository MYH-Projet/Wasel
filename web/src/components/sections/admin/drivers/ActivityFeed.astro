---
import { History } from "lucide-react";
import type { DriverDetails } from "@/types/driver";

interface Props {
    driverData: DriverDetails;
}

const { driverData } = Astro.props;

// Activity feed is not yet provided by the backend.
// For now, we generate contextual entries from the driver's data.
const activities: { title: string; time: string; type: string }[] = [];

if (driverData.verificationDate) {
    activities.push({
        title: "Dossier verified by admin",
        time: new Date(driverData.verificationDate).toLocaleDateString(),
        type: "system",
    });
}
if (driverData.submissionDate) {
    activities.push({
        title: "Dossier submitted for review",
        time: new Date(driverData.submissionDate).toLocaleDateString(),
        type: "system",
    });
}
activities.push({
    title: "Account created",
    time: new Date(driverData.createdAt).toLocaleDateString(),
    type: "system",
});
---

<div class="bg-card rounded-xl shadow-sm p-6 h-full flex flex-col">
    <h2 class="text-lg font-bold text-foreground flex items-center gap-3 mb-8">
        <span class="p-2 bg-orange-100 text-orange-700 rounded-lg">
            <History className="w-5 h-5" />
        </span>
        Activity Feed
    </h2>

    <div
        class="relative border-l-2 border-border ml-3 space-y-8 flex-grow mb-8"
    >
        {
            activities.map((activity) => (
                <div class="relative pl-6">
                    <span
                        class={`absolute -left-[9px] top-1.5 w-4 h-4 rounded-full border-4 border-white ${
                            activity.type === "mission"
                                ? "bg-yellow-700"
                                : "bg-muted"
                        }`}
                    />
                    <p class="text-sm font-medium text-foreground">
                        {activity.title}
                    </p>
                    <p class="text-xs text-muted-foreground mt-0.5">
                        {activity.time}
                    </p>
                </div>
            ))
        }
    </div>

    <button
        class="w-full py-2.5 border border-border text-foreground text-sm font-medium rounded-lg hover:bg-muted transition-colors mt-auto"
    >
        View Full History
    </button>
</div>
