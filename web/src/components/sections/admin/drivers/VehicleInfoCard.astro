---
import { Bike } from "lucide-react";

interface Props {
    driverId: string | undefined;
}
const { driverId } = Astro.props;

// Simulate API Fetch
await new Promise((r) => setTimeout(r, 800));

const vehicleInfo = {
    type: "Motorcycle (Heavy Duty)",
    plate: "CA 882-XR9",
    status: "Valid until Dec 2024",
    // imageUrl:
    //     "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=800&auto=format&fit=crop",
};
---

<div class="bg-white rounded-xl shadow-sm p-6 h-full flex flex-col">
    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-3 mb-8">
        <span class="p-2 bg-slate-100 text-slate-700 rounded-lg">
            <Bike className="w-5 h-5" />
        </span>
        Vehicle Info
    </h2>

    <div class="space-y-6 flex-grow">
        <div>
            <p
                class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1"
            >
                Vehicle Type
            </p>
            <p class="text-slate-800 font-medium">{vehicleInfo.type}</p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1"
            >
                License Plate
            </p>
            <p class="text-slate-900 font-bold">{vehicleInfo.plate}</p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1"
            >
                Registration Status
            </p>
            <p class="text-slate-800 font-medium flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-600"></span>
                {vehicleInfo.status}
            </p>
        </div>
    </div>

    <!-- <div
        class="mt-6 rounded-xl overflow-hidden h-32 bg-slate-900 flex-shrink-0"
    >
        <img
            src={vehicleInfo.imageUrl}
            alt="Vehicle"
            class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity"
        />
    </div> -->
</div>
