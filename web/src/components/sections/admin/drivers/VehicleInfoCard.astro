---
import { Bike } from "lucide-react";
import type { DriverDetails } from "@/types/driver";

interface Props {
    driverData: DriverDetails;
}

const { driverData } = Astro.props;
const vehicle = driverData.vehicle;
---

<div class="bg-card rounded-xl shadow-sm p-6 h-full flex flex-col">
    <h2 class="text-lg font-bold text-foreground flex items-center gap-3 mb-8">
        <span class="p-2 bg-muted text-foreground rounded-lg">
            <Bike className="w-5 h-5" />
        </span>
        Vehicle Info
    </h2>

    <div class="space-y-6 flex-grow">
        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Vehicle Type
            </p>
            <p class="text-foreground font-medium">
                {vehicle?.type || "N/A"}
            </p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                License Plate
            </p>
            <p class="text-foreground font-bold">
                {vehicle?.matricule || "N/A"}
            </p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Brand
            </p>
            <p class="text-foreground font-medium">
                {vehicle?.marque || "N/A"}
            </p>
        </div>

        <div>
            <p
                class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Model
            </p>
            <p class="text-foreground font-medium">
                {vehicle?.model || "N/A"}
            </p>
        </div>
    </div>
</div>
