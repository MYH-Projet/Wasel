---
import { Package, AlertTriangle } from "lucide-react";

interface Props {
    deliveryId: string;
}
const { deliveryId } = Astro.props;

await new Promise((r) => setTimeout(r, 500));
---

<div class="bg-card rounded-xl shadow-sm p-6 border border-border">
    <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-6">
        Package Details
    </h3>

    <div class="flex items-start gap-4 mb-6">
        <div class="p-3 bg-primary/10 text-primary rounded-lg shrink-0">
            <Package className="w-6 h-6" />
        </div>
        <div>
            <p class="font-bold text-foreground leading-tight">
                Premium Bond Paper (10 Cases)
            </p>
            <p class="text-sm text-muted-foreground mt-1">ID: PKG-2281-B</p>
        </div>
    </div>

    <div class="flex gap-4">
        <div class="flex-1 bg-muted/40 rounded-lg p-3">
            <p
                class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
            >
                Weight
            </p>
            <p class="font-bold text-foreground">45.5 kg</p>
        </div>
        <div
            class="flex-1 bg-destructive/10 border border-destructive/20 rounded-lg p-3 flex justify-between items-center"
        >
            <div>
                <p
                    class="text-[10px] font-bold text-destructive/80 uppercase tracking-wider mb-1"
                >
                    Status
                </p>
                <p class="font-bold text-destructive">Fragile</p>
            </div>
            <AlertTriangle className="w-5 h-5 text-destructive" />
        </div>
    </div>
</div>
