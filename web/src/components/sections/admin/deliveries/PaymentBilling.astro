---
import { CreditCard } from "lucide-react";

interface Props {
    deliveryId: string;
}
const { deliveryId } = Astro.props;

await new Promise((r) => setTimeout(r, 650));
---

<div class="bg-card rounded-xl shadow-sm p-6 border border-border">
    <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-6">
        Payment & Billing
    </h3>

    <div
        class="flex items-center justify-between pb-4 border-b border-border mb-4"
    >
        <p class="text-sm text-muted-foreground">Method</p>
        <div class="flex items-center gap-2 font-bold text-foreground">
            <CreditCard className="w-5 h-5 text-muted-foreground/60" />
            <div class="text-right leading-tight">
                <p>Corporate Visa</p>
                <p class="text-xs text-muted-foreground">****4242</p>
            </div>
        </div>
    </div>

    <div class="space-y-3 mb-6">
        <div class="flex justify-between items-center text-sm">
            <p class="text-muted-foreground">Service Fee</p>
            <p class="font-medium text-foreground">$24.50</p>
        </div>
        <div class="flex justify-between items-center text-sm">
            <p class="text-muted-foreground">Distance Charge</p>
            <p class="font-medium text-foreground">$152.00</p>
        </div>
    </div>

    <div class="flex justify-between items-end mb-6">
        <p class="font-bold text-foreground">Total Amount</p>
        <p class="text-2xl font-black text-foreground">$176.50</p>
    </div>

    <button
        class="w-full py-2.5 bg-secondary hover:bg-secondary/90 text-secondary-foreground font-bold rounded-lg transition-colors text-sm"
    >
        View Invoice Details
    </button>
</div>
