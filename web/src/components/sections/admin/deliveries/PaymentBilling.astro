---
import { CreditCard, Wallet, Banknote } from "lucide-react";
import type { DeliveryDetails } from "@/types/delivery";

interface Props {
    deliveryData: DeliveryDetails;
}

const { deliveryData } = Astro.props;
const payment = deliveryData?.payment;

const getPaymentIcon = (method: string) => {
    switch (method?.toLowerCase()) {
        case 'card':
        case 'visa':
        case 'mastercard':
            return CreditCard;
        case 'cash':
            return Banknote;
        default:
            return Wallet;
    }
};

const PaymentIcon = getPaymentIcon(payment?.method || payment?.paymentMethod || '');
---

<div class="bg-card rounded-xl shadow-sm p-6 border border-border">
    <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-6">
        Payment & Billing
    </h3>

    <div
        class="flex items-center justify-between pb-4 border-b border-border mb-4"
    >
        <p class="text-sm text-muted-foreground">Method</p>
        <div class="flex items-center gap-2 font-bold text-foreground">
            <PaymentIcon className="w-5 h-5 text-muted-foreground/60" />
            <div class="text-right leading-tight">
                <p>{payment?.method || payment?.paymentMethod || "Unknown"}</p>
                <p class="text-xs text-muted-foreground">{payment?.status || payment?.paymentStatus || "Pending"}</p>
            </div>
        </div>
    </div>

    <div class="flex justify-between items-end mb-6">
        <p class="font-bold text-foreground">Total Amount</p>
        <p class="text-2xl font-black text-foreground">{payment?.amount ? `${payment.amount.toFixed(2)} MAD` : "--- MAD"}</p>
    </div>

    <button
        class="w-full py-2.5 bg-secondary hover:bg-secondary/90 text-secondary-foreground font-bold rounded-lg transition-colors text-sm"
    >
        View Invoice Details
    </button>
</div>
