---
import { Check } from "lucide-react";
import { format } from "date-fns";
import type { DeliveryDetails } from "@/types/delivery";

interface Props {
    deliveryData: DeliveryDetails;
}

const { deliveryData } = Astro.props;


const history = deliveryData?.statusHistory || [];
const timeline = history.map((item: any, index: number) => {
    const rawStatus = item.status || item.deliveryStatus || "";
    const rawTimestamp = item.timestamp || item.changedAt;
    const rawDesc = item.note || item.comment || "";
    
    return {
        title: rawStatus.replace(/_/g, ' '),
        date: rawTimestamp ? format(new Date(rawTimestamp), "MMM dd, yyyy • hh:mm a") : "",
        desc: rawDesc,
        status: index === history.length - 1 ? "current" : "completed",
    };
});
---

<div class="bg-card rounded-xl shadow-sm p-6 lg:p-8 border border-border">
    <h2 class="text-xl font-bold text-foreground mb-8">Delivery Timeline</h2>

    <div class="relative border-l-[3px] border-primary/20 ml-4 space-y-10">
        {
            timeline.map((step) => (
                <div class="relative pl-8">
                    <span
                        class={`absolute -left-[15px] top-0 w-[27px] h-[27px] rounded-full border-4 border-card flex items-center justify-center shadow-sm ${
                            step.status === "completed"
                                ? "bg-primary text-primary-foreground"
                                : "bg-card border-[3px] !border-primary text-primary"
                        }`}
                    >
                        {step.status === "completed" ? (
                            <Check className="w-3.5 h-3.5 stroke-[3]" />
                        ) : (
                            <span class="w-2 h-2 bg-primary rounded-full" />
                        )}
                    </span>

                    <div class="-mt-1.5">
                        <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
                            <h3
                                class={`text-base font-bold ${step.status === "current" ? "text-primary" : "text-foreground"}`}
                            >
                                {step.title}
                            </h3>
                            <span class="text-xs font-medium text-muted-foreground mt-1 sm:mt-0">
                                {step.date}
                            </span>
                        </div>
                        <p class="text-sm text-muted-foreground/90 mt-2 leading-relaxed">
                            {step.desc}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</div>
