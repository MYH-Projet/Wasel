---
import { MapPin } from "lucide-react";
import type { DeliveryDetails } from "@/types/delivery";

interface Props {
    deliveryData: DeliveryDetails;
    token: string;
}

const { deliveryData, token } = Astro.props;

const pickup = deliveryData?.pickupAddress;
const delivery = deliveryData?.deliveryAddress;

// Fallback to Pickup Address since live driver coords are pending
const locationFallback = pickup
    ? `${pickup.street}, ${pickup.city}`
    : "Location tracking pending...";

const trackingData = {
    currentLocation: locationFallback,
    heading:
        deliveryData?.deliveryStatus === "IN_TRANSIT"
            ? "Waiting for driver..."
            : deliveryData?.deliveryStatus?.replace(/_/g, " ") || "Pending",
    lastUpdated: "Not connected",
};
---

<div
    class="relative bg-slate-100 rounded-xl shadow-sm overflow-hidden h-[400px] border border-border flex flex-col"
>
    <div
        class="absolute top-0 left-0 right-0 p-4 flex justify-between items-center z-[1000] bg-gradient-to-b from-slate-900/80 to-transparent pointer-events-none"
    >
        <h2
            class="text-lg font-bold text-white flex items-center gap-2 pointer-events-auto"
        >
            <MapPin className="w-5 h-5 text-primary" /> Live Tracking Map
        </h2>
        <div id="tracking-status-badge" class="flex items-center gap-2 text-sm text-slate-300 font-medium pointer-events-auto bg-slate-900/60 px-3 py-1.5 rounded-full backdrop-blur-xs">
            <span id="tracking-status-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span id="tracking-status-text">Offline</span>
        </div>
    </div>

    <delivery-map
        class="absolute inset-0 z-0 w-full h-full"
        data-plat={pickup?.latitude}
        data-plng={pickup?.longitude}
        data-pname={pickup?.label}
        data-dlat={delivery?.latitude}
        data-dlng={delivery?.longitude}
        data-dname={delivery?.label}
        data-token={token}
        data-deliveryid={deliveryData?.id}
        data-status={deliveryData?.deliveryStatus}
        data-drivername={deliveryData?.assignedDriver?.name}
    >
        <div id="map" class="w-full h-full z-0"></div>
    </delivery-map>

    <div
        class="absolute bottom-6 left-6 bg-card p-4 rounded-lg shadow-xl border border-border min-w-[280px] z-3 pointer-events-auto"
    >
        <p
            class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
        >
            Driver Information
        </p>
        <p id="live-driver-name" class="font-bold text-foreground">{deliveryData?.assignedDriver?.name || "No driver assigned"}</p>
        <p id="live-tracking-details" class="text-sm text-muted-foreground/90 mt-1">
            {trackingData.heading}
        </p>
    </div>
</div>

<script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";
    import { HubConnectionBuilder, HttpTransportType, LogLevel } from "@microsoft/signalr";

    class DeliveryMap extends HTMLElement {
        private connection: any = null;
        private driverMarker: L.Marker | null = null;
        private map: L.Map | null = null;

        async connectedCallback() {
            const mapContainer = this.querySelector("#map") as HTMLElement;
            // Prevent double initialization during HMR (Hot Module Replacement) in dev mode
            if (!mapContainer || (mapContainer as any)._leaflet_id) return;

            // 1. Grab attributes
            const pLat = parseFloat(this.dataset.plat || "");
            const pLng = parseFloat(this.dataset.plng || "");
            const dLat = parseFloat(this.dataset.dlat || "");
            const dLng = parseFloat(this.dataset.dlng || "");
            const token = this.dataset.token || "";
            const deliveryId = this.dataset.deliveryid || "";
            const status = this.dataset.status || "";
            const driverName = this.dataset.drivername || "Driver";

            const statusDot = document.getElementById("tracking-status-dot");
            const statusText = document.getElementById("tracking-status-text");
            const trackingDetails = document.getElementById("live-tracking-details");

            const updateStatusUI = (type: "connecting" | "live" | "offline" | "no-driver") => {
                if (!statusDot || !statusText) return;
                if (type === "connecting") {
                    statusDot.className = "w-2 h-2 rounded-full bg-amber-400 animate-pulse";
                    statusText.innerText = "Connecting to GPS...";
                } else if (type === "live") {
                    statusDot.className = "w-2 h-2 rounded-full bg-emerald-500 animate-pulse";
                    statusText.innerText = "Live tracking";
                } else if (type === "offline") {
                    statusDot.className = "w-2 h-2 rounded-full bg-slate-400";
                    statusText.innerText = "Driver offline";
                } else if (type === "no-driver") {
                    statusDot.className = "w-2 h-2 rounded-full bg-slate-400";
                    statusText.innerText = "No driver assigned";
                }
            };

            if (isNaN(pLat) || isNaN(pLng)) {
                updateStatusUI("offline");
                return;
            }

            // 2. Initialize the Map
            this.map = L.map(mapContainer, {
                zoomControl: false, // Hiding default zoom controls for a cleaner dashboard look
            }).setView([pLat, pLng], 13);

            // 3. Add a modern, clean map tile layer (CartoDB Positron)
            L.tileLayer(
                "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                {
                    attribution:
                        "&copy; OpenStreetMap contributors &copy; CARTO",
                },
            ).addTo(this.map);

            // 4. Create custom HTML markers (Avoids missing image bugs in Vite/Astro)
            const createDotIcon = (colorClass: string) =>
                L.divIcon({
                    className: "custom-leaflet-icon",
                    html: `<div class="w-4 h-4 ${colorClass} rounded-full border-2 border-white shadow-md"></div>`,
                    iconSize: [16, 16],
                    iconAnchor: [8, 8],
                });

            // 5. Place the Pickup and Delivery markers
            L.marker([pLat, pLng], {
                icon: createDotIcon("bg-slate-900"),
            })
                .addTo(this.map)
                .bindPopup(this.dataset.pname || "Pickup");

            if (!isNaN(dLat) && !isNaN(dLng)) {
                L.marker([dLat, dLng], {
                    icon: createDotIcon("bg-primary"),
                })
                    .addTo(this.map)
                    .bindPopup(this.dataset.dname || "Delivery");

                // Draw route line
                const routeLine = L.polyline(
                    [
                        [pLat, pLng],
                        [dLat, dLng],
                    ],
                    {
                        color: "hsl(var(--primary))",
                        weight: 3,
                        dashArray: "5, 10",
                    },
                ).addTo(this.map);

                // Auto-zoom the map
                this.map.fitBounds(routeLine.getBounds(), { padding: [50, 50] });
            }

            // 6. Check if delivery is active for tracking
            const isActiveStatus = ["ACCEPTED", "PICKED_UP", "IN_TRANSIT"].includes(status);
            if (!isActiveStatus) {
                updateStatusUI(status === "CREATED" ? "no-driver" : "offline");
                if (trackingDetails) {
                    trackingDetails.innerText = status.replace(/_/g, " ");
                }
                return;
            }

            updateStatusUI("connecting");

            // 7. Get last known position of the driver (if any)
            try {
                const res = await fetch(`/api/tracking/deliveries/${deliveryId}/last-position`, {
                    headers: {
                        Authorization: `Bearer ${token}`
                    }
                });
                if (res.ok) {
                    const lastPos = await res.json();
                    if (lastPos && lastPos.latitude && lastPos.longitude) {
                        this.updateDriverMarker(lastPos.latitude, lastPos.longitude, driverName, lastPos.heading);
                    }
                }
            } catch (e) {
                console.warn("Failed to fetch last known position:", e);
            }

            // 8. Connect to SignalR GpsHub
            try {
                // Connect via proxy port 8000
                const hubUrl = `${window.location.protocol}//${window.location.host}/api/hubs/gps?access_token=${token}`;
                this.connection = new HubConnectionBuilder()
                    .withUrl(hubUrl, {
                        skipNegotiation: true,
                        transport: HttpTransportType.WebSockets
                    })
                    .withAutomaticReconnect()
                    .configureLogging(LogLevel.Warning)
                    .build();

                this.connection.on("ReceivePosition", (pos: any) => {
                    if (pos && pos.latitude && pos.longitude) {
                        updateStatusUI("live");
                        if (trackingDetails) {
                            const speed = pos.speedKmh ? ` · ${Math.round(pos.speedKmh)} km/h` : "";
                            trackingDetails.innerText = `In Transit${speed}`;
                        }
                        this.updateDriverMarker(pos.latitude, pos.longitude, driverName, pos.heading);
                    }
                });

                this.connection.onreconnecting(() => {
                    updateStatusUI("connecting");
                });

                this.connection.onreconnected(() => {
                    updateStatusUI("live");
                    this.connection.invoke("JoinDeliveryGroup", deliveryId).catch(console.error);
                });

                this.connection.onclose(() => {
                    updateStatusUI("offline");
                });

                await this.connection.start();
                updateStatusUI("live");
                await this.connection.invoke("JoinDeliveryGroup", deliveryId);

            } catch (err) {
                console.error("SignalR Connection Error:", err);
                updateStatusUI("offline");
            }
        }

        disconnectedCallback() {
            if (this.connection) {
                this.connection.stop().catch(console.error);
            }
        }

        private updateDriverMarker(lat: number, lng: number, driverName: string, heading?: number) {
            if (!this.map) return;

            // Custom HTML marker for driver (Green arrow or pulse)
            const angle = heading || 0;
            const iconHtml = `
                <div class="relative flex items-center justify-center">
                    <div class="absolute w-8 h-8 bg-emerald-500/30 rounded-full animate-ping"></div>
                    <div class="relative w-6 h-6 bg-emerald-500 rounded-full border-2 border-white shadow-lg flex items-center justify-center text-white" style="transform: rotate(${angle}deg)">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    </div>
                </div>
            `;

            const driverIcon = L.divIcon({
                className: "custom-leaflet-icon",
                html: iconHtml,
                iconSize: [32, 32],
                iconAnchor: [16, 16],
            });

            if (this.driverMarker) {
                this.driverMarker.setLatLng([lat, lng]);
                this.driverMarker.setIcon(driverIcon);
            } else {
                this.driverMarker = L.marker([lat, lng], { icon: driverIcon })
                    .addTo(this.map)
                    .bindPopup(`${driverName} (Driver)`);
            }

            // Adjust map bounds to include driver
            const bounds = [];
            const pLat = parseFloat(this.dataset.plat || "");
            const pLng = parseFloat(this.dataset.plng || "");
            const dLat = parseFloat(this.dataset.dlat || "");
            const dLng = parseFloat(this.dataset.dlng || "");

            if (!isNaN(pLat) && !isNaN(pLng)) bounds.push([pLat, pLng]);
            if (!isNaN(dLat) && !isNaN(dLng)) bounds.push([dLat, dLng]);
            bounds.push([lat, lng]);

            this.map.fitBounds(L.latLngBounds(bounds as [number, number][]), { padding: [50, 50] });
        }
    }

    customElements.define("delivery-map", DeliveryMap);
</script>

<style is:global>
    /* Ensures Leaflet popup layers don't overlap our Tailwind Absolute overlays */
    .leaflet-pane {
        z-index: 1 !important;
    }
    .leaflet-top,
    .leaflet-bottom {
        z-index: 10 !important;
    }
    /* Removes the white background from our custom markers */
    .custom-leaflet-icon {
        background: transparent;
        border: none;
    }
</style>
