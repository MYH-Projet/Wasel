---
import { MapPin } from "lucide-react";

interface Props {
    deliveryId: string;
}
const { deliveryId } = Astro.props;

// Simulate API Fetch
await new Promise((r) => setTimeout(r, 800));

const trackingData = {
    currentLocation: "452 Market St, San Francisco, CA",
    heading: "Heading North - 35 mph",
    lastUpdated: "2m ago",
};
---

<div
    class="relative bg-slate-900 rounded-xl shadow-sm overflow-hidden h-[400px] border border-border flex flex-col"
>
    <div
        class="absolute top-0 left-0 right-0 p-4 flex justify-between items-center z-10 bg-gradient-to-b from-slate-900/80 to-transparent"
    >
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <MapPin className="w-5 h-5 text-primary" /> Live Tracking Map
        </h2>
        <div class="flex items-center gap-2 text-sm text-slate-300 font-medium">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"
            ></span>
            Last updated {trackingData.lastUpdated}
        </div>
    </div>

    <img
        src="https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=1200&auto=format&fit=crop"
        alt="Map Background"
        class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity"
    />

    <div class="absolute inset-0 flex items-center justify-center">
        <svg
            class="w-full h-full drop-shadow-lg"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
        >
            <path
                d="M 20 80 L 40 80 L 50 40 L 80 20"
                fill="none"
                stroke="var(--primary)"
                stroke-width="2"
                class="animate-[dash_3s_linear_infinite]"
                stroke-dasharray="4 4"></path>
        </svg>
    </div>

    <div
        class="absolute bottom-6 left-6 bg-card p-4 rounded-lg shadow-xl border border-border min-w-[280px] z-10"
    >
        <p
            class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider mb-1"
        >
            Current Location
        </p>
        <p class="font-bold text-foreground">{trackingData.currentLocation}</p>
        <p class="text-sm text-muted-foreground/90 mt-1">{trackingData.heading}</p>
    </div>
</div>
