---
interface Props {
    deliveryId: string;
}
const { deliveryId } = Astro.props;

await new Promise((r) => setTimeout(r, 700));
---

<div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-6">
        Route Information
    </h3>

    <div
        class="relative border-l-[2px] border-dashed border-slate-300 ml-2.5 space-y-6"
    >
        <div class="relative pl-6">
            <span
                class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-slate-900 ring-4 ring-white"
            ></span>
            <p
                class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-0.5"
            >
                Pickup
            </p>
            <p class="font-bold text-slate-900">Dunder Mifflin Hub</p>
            <p class="text-sm text-slate-500 mt-0.5">
                1725 Slough Ave, Scranton, PA
            </p>
        </div>

        <div class="relative pl-6">
            <span
                class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-yellow-700 ring-4 ring-white"
            ></span>
            <p
                class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-0.5"
            >
                Drop-off
            </p>
            <p class="font-bold text-slate-900">Corporate Towers, Ste 400</p>
            <p class="text-sm text-slate-500 mt-0.5">
                101 Market St, San Francisco, CA
            </p>
        </div>
    </div>
</div>
