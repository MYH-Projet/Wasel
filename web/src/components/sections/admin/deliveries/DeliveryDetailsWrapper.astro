---
import LiveTrackingMap from "./LiveTrackingMap.astro";
import DeliveryTimeline from "./DeliveryTimeline.astro";
import ContactInfo from "./ContactInfo.astro";
import RouteInfo from "./RouteInfo.astro";
import PackageDetails from "./PackageDetails.astro";
import PaymentBilling from "./PaymentBilling.astro";
import type { DeliveryDetails } from "@/types/delivery";

interface Props {
    deliveryId: string;
}

const { deliveryId } = Astro.props;
const INTERNAL_API_URL = import.meta.env.INTERNAL_API_URL;
const user = Astro.locals.user;

let deliveryData: DeliveryDetails | null = null;

const mockDelivery: DeliveryDetails = {
    id: deliveryId || "mock-123456",
    deliveryStatus: "IN_TRANSIT",
    createdAt: new Date().toISOString(),
    pickupAddress: {
        id: "addr-111",
        label: "Dunder Mifflin Hub",
        street: "1725 Slough Ave",
        city: "Scranton",
        latitude: 33.5731,
        longitude: -7.5898
    },
    deliveryAddress: {
        id: "addr-222",
        label: "Corporate Towers, Ste 400",
        street: "101 Market St",
        city: "San Francisco",
        latitude: 33.5800,
        longitude: -7.6200
    },
    parcel: {
        weight: 45.5,
        isFragile: true,
        description: "Premium Bond Paper (10 Cases)"
    },
    payment: {
        amount: 176.50,
        method: "Credit Card",
        status: "Paid"
    },
    assignedDriver: {
        name: "Michael Scott",
        phone: "+1 570-555-0123",
        vehicle: "PT Cruiser"
    },
    statusHistory: [
        {
            status: "DELIVERY_REQUESTED",
            timestamp: "2026-05-20T09:12:00Z",
            note: "Order received and processed via automated dispatcher."
        },
        {
            status: "DRIVER_ASSIGNED",
            timestamp: "2026-05-20T09:45:00Z",
            note: "Michael Scott (ID: #DR-992) accepted the request."
        },
        {
            status: "PACKAGE_PICKED_UP",
            timestamp: "2026-05-20T10:20:00Z",
            note: "Pickup verified at South Hub Terminal A."
        },
        {
            status: "IN_TRANSIT",
            timestamp: "2026-05-20T10:45:00Z",
            note: "On the way to the delivery destination. Estimated arrival: 11:30 AM."
        }
    ]
};

if (deliveryId === "mock" || deliveryId === "demo") {
    deliveryData = mockDelivery;
} else {
    try {
        const response = await fetch(
            `${INTERNAL_API_URL}/api/deliveries/${deliveryId}`,
            {
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${user?.token}`,
                },
            },
        );

        if (!response.ok) {
            console.warn(`Fetch failed with status ${response.status}. Falling back to mock data for preview.`);
            deliveryData = mockDelivery;
        } else {
            deliveryData = await response.json();
        }
    } catch (e) {
        console.error("Backend fetch error. Falling back to mock data for preview:", e);
        deliveryData = mockDelivery;
    }
}
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        <LiveTrackingMap deliveryData={deliveryData!} />
        <DeliveryTimeline deliveryData={deliveryData!} />
    </div>

    <div class="space-y-6">
        <ContactInfo deliveryData={deliveryData!} />
        <PackageDetails deliveryData={deliveryData!} />
        <PaymentBilling deliveryData={deliveryData!} />
        <RouteInfo deliveryData={deliveryData!} />
    </div>
</div>
