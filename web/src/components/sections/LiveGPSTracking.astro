---
import { CheckCircle2 } from "lucide-react";
import LiveTrackingImage from "../../assets/images/LiveTracking.png";
import { Image } from "astro:assets";
---

<section
  id="gps-tracking"
  class="py-20 md:py-32 px-6 lg:px-8 bg-background overflow-hidden"
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12 lg:gap-20"
  >
    <!-- Text Content -->
    <div class="flex-1 space-y-8">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-foreground tracking-tight"
      >
        Live GPS Tracking
      </h2>
      <p
        class="text-lg md:text-xl text-muted-foreground leading-relaxed font-light"
      >
        Follow your package every step of the way with live location sharing and
        integrated map visualization.
      </p>

      <div class="space-y-4 pt-4">
        <div class="flex items-center gap-3">
          <div class="text-primary bg-primary/10 rounded-full p-1">
            <CheckCircle2 size={20} strokeWidth={3} />
          </div>
          <span class="text-foreground font-medium"
            >Real-time updates from pickup to drop-off</span
          >
        </div>
        <div class="flex items-center gap-3">
          <div class="text-primary bg-primary/10 rounded-full p-1">
            <CheckCircle2 size={20} strokeWidth={3} />
          </div>
          <span class="text-foreground font-medium"
            >Accurate estimated times of arrival (ETA)</span
          >
        </div>
      </div>
    </div>

    <!-- Visual -->
    <div class="flex-1 w-full flex justify-center md:justify-end relative">
      <!-- Decorative background blob -->
      <div
        class="absolute inset-0 bg-primary/30 rounded-3xl transform rotate-3 scale-105 z-0"
      >
      </div>

      <div
        class="relative z-10 bg-background rounded-2xl shadow-2xl border-8 border-gray-100 max-w-md w-full aspect-1/2 flex flex-col overflow-hidden"
      >
        <!-- Phone Top Notch -->
        <Image
          src={LiveTrackingImage}
          alt="Live GPS tracking map view on a mobile app"
          class="w-full h-full object-cover rounded-2xl"
          loading="lazy"
          quality={75}
        />
      </div>
    </div>
  </div>
</section>
