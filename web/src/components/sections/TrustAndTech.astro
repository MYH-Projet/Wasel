---
import { Activity, ShieldCheck, Cloud } from "lucide-react";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const features = [
  {
    icon: Activity,
    title: "Real-time Flow",
    description:
      "Our platform processes millions of data points instantly to coordinate seamless handoffs between clients and independent drivers.",
  },
  {
    icon: ShieldCheck,
    title: "Secure Communications",
    description:
      "End-to-end encryption and masked phone numbers keep your personal information completely private and secure.",
  },
  {
    icon: Cloud,
    title: "Cloud Performance",
    description:
      "Hosted on robust cloud infrastructure to ensure 99.9% uptime, so the marketplace is always available when you need it most.",
  },
];
---

<section
  id="technology"
  class="py-24 px-6 lg:px-8 bg-background relative overflow-hidden"
>
  <!-- Decorative Glow Blobs -->
  <div
    class="absolute top-0 left-1/4 w-4xl h-4xl bg-primary/10 rounded-full blur-[120px] z-0"
  >
  </div>
  <div
    class="absolute bottom-0 right-1/4 w-4xl h-4xl bg-secondary/10 rounded-full blur-[120px] z-0"
  >
  </div>

  <!-- Background Grid Pattern -->
  <div
    class="absolute inset-0 z-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 relative z-10">
      <h2
        class="text-3xl md:text-5xl font-extrabold text-foreground tracking-tight"
      >
        Built on <span class="text-primary relative inline-block">
          Trust & Technology
        </span>
      </h2>
      <p
        class="text-lg text-muted-foreground mt-6 max-w-2xl mx-auto font-light"
      >
        A state-of-the-art logistics engine designed to handle thousands of
        concurrent deliveries effortlessly.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        features.map((feature) => {
          const Icon = feature.icon;
          return (
            <Card className="bg-card/80 backdrop-blur-sm border border-border p-8 rounded-[2.5rem] shadow-lg hover:shadow-2xl hover:-translate-y-2 hover:border-primary/50 transition-all duration-300 relative overflow-hidden group">
              <CardHeader>
                <div class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-primary transition-all duration-300 shadow-sm">
                  <Icon
                    size={28}
                    className="text-primary group-hover:text-primary-foreground transition-colors"
                  />
                </div>
                <CardTitle className="text-xl font-bold text-foreground mb-3">
                  {feature.title}
                </CardTitle>
                <CardDescription className="text-muted-foreground text-sm leading-relaxed">
                  {feature.description}
                </CardDescription>
              </CardHeader>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>
