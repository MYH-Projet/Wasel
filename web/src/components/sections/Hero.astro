---
import { Image } from "astro:assets";
import heroImage from "@/assets/images/hero.png";
---

<section
    class="relative w-full min-h-[600px] h-[85vh] max-h-[900px] bg-background overflow-hidden flex flex-col"
>
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <Image
            src={heroImage}
            alt="Hero Background"
            width={1920}
            height={1080}
            class="w-full h-full object-cover object-center"
        />
        <!-- Dark Gradient Overlay for text readability -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"
        >
        </div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <!-- Content Container -->
    <div
        class="relative z-10 w-full max-w-7xl mx-auto flex-1 flex flex-col justify-between px-6 pt-24 pb-8"
    >
        <!-- Top Text & Button -->
        <div class="max-w-3xl mt-4 md:mt-10">
            <h1
                class="text-5xl sm:text-6xl md:text-[5.5rem] font-extrabold tracking-tight leading-[1.1] mb-6 text-white"
            >
                Fast Flexible <br />
                Local Delivery <br />
                <span
                    class="inline-block bg-primary text-primary-foreground px-3 py-1 rounded-md mt-2"
                    >on Demand</span
                >
            </h1>
            <div
                class="text-lg md:text-xl text-muted space-y-1 mb-10 font-light border-l-2 border-primary pl-2"
            >
                <p>Get your packages delivered across town in minutes.</p>
                <p>Reliable, secure, and always at your fingertips.</p>
            </div>
        </div>
    </div>
</section>
