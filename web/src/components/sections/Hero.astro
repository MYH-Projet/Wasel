---
import { Image } from "astro:assets";
import heroImage from "@/assets/images/hero.png";
---

<section class="relative w-full bg-background overflow-hidden">
    <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between"
    >
        <!-- left text -->
        <div class="w-full md:w-1/2 px-6 lg:px-8 py-16 md:py-24 z-10">
            <h1
                class="text-6xl md:text-7xl font-extrabold tracking-tight text-foreground leading-20 mb-6"
            >
                Fast Flexible <br />
                Local Delivery <br />
                <span class="text-primary">on</span>
                <span class="text-primary">Demand</span>
            </h1>
            <div
                class="text-lg md:text-xl text-muted-foreground space-y-1 mb-10"
            >
                <p>Get your packages delivered across town in minutes.</p>
                <p>Reliable, secure, and always at your fingertips.</p>
            </div>
        </div>

        <!-- right image -->
        <div class="w-full md:w-1/2 px-6 lg:px-8 py-8 md:py-16">
            <div
                class="relative h-[400px] md:h-[600px] rounded-2xl overflow-hidden shadow-2xl"
            >
                <Image
                    src={heroImage}
                    alt="Delivery person on scooter"
                    width={1024}
                    height={720}
                    class="w-full h-full object-cover object-center"
                />
            </div>
        </div>
    </div>
</section>
