---
import { Clock, TrendingUp, Star } from "lucide-react";

const features = [
  {
    icon: Clock,
    title: "Total Control",
    description:
      "Work when you want, where you want. No minimum hours, complete freedom.",
    className: "col-span-1 sm:col-span-2 xl:col-span-2",
  },
  {
    icon: TrendingUp,
    title: "Work Smart",
    description:
      "Our app optimizes your routes so you spend less time driving and more time earning.",
    className: "col-span-1 sm:col-span-2 xl:col-span-2",
  },
  {
    icon: Star,
    title: "Build Your Reputation",
    description:
      "Get rewarded for great service with our rating system and in-app tipping features.",
    className: "col-span-1 sm:col-span-2 xl:col-span-2",
  },
];
---

<section
  id="drivers"
  class="py-24 px-6 lg:px-8 bg-secondary text-secondary-foreground"
>
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
    <!-- Left: Text Content -->
    <div class="space-y-8 max-w-lg">
      <h2
        class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight"
      >
        Drive with Wasel.<br />
        <span class="text-primary">Earn on your terms.</span>
      </h2>
      <p
        class="text-lg md:text-xl text-secondary-foreground/80 font-light leading-relaxed"
      >
        Join our fleet of independent courier professionals. Set your own
        schedule, be your own boss, and get paid quickly.
      </p>
    </div>

    <!-- Right: Feature Cards Grid -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
      {
        features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div
              class={`bg-black/20 p-8 rounded-3xl border border-secondary-foreground/10 hover:border-primary/30 transition-colors ${feature.className}`}
            >
              <Icon size={24} className="text-primary mb-4" />
              <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
              <p class="text-secondary-foreground/70 text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
