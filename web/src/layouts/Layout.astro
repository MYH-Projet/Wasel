---
import "../styles/global.css";
import { NavBar } from "../components/sections/NavBar.tsx";
import Footer from "../components/sections/Footer.astro";
import { getImage } from "astro:assets";
import logoImage from "../assets/images/wasel-logo.png";

const logo = await getImage({
	src: logoImage,
	alt: "wasel logo",
	width: 60,
	height: 45,
	format: "webp",
	quality: 80,
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Wasel — Fast, Flexible Local Delivery on Demand</title>
		<meta name="description" content="Get your packages delivered across town in minutes with Wasel. Reliable, secure, and always at your fingertips. Track in real-time, pay flexibly, and trust our drivers." />
	</head>
	<body
		class="min-h-screen bg-background font-sans text-foreground antialiased flex flex-col"
	>
		<NavBar client:idle logo={logo} />
		<main class="flex-1 flex flex-col">
			<slot />
		</main>
		<Footer />
	</body>
</html>
