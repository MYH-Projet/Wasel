# ══════════════════════════════════════════════════
# Wasel — Environment Variables (Development)
# ══════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to Git.

# Global
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_USER=wasel_user
POSTGRES_PASSWORD=wasel_dev_password
POSTGRES_DB=wasel_db

# Redis
REDIS_CONNECTION_STRING=wasel-redis:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=wasel-documents

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=wasel
KEYCLOAK_CLIENT_ID=wasel-api

# Frontend
VITE_API_URL=http://localhost:5000/api
VITE_KEYCLOAK_URL=http://localhost:8080/auth

# Keycloak Custom Image
KEYCLOAK_IMAGE=your-dockerhub-username/wasel-keycloak:latest
KEYCLOAK_TAG=latest
